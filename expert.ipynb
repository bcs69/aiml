   "source": [
    "facts = {\"rain\", \"cold\"}\n",
    "rules = [\n",
    "    ({\"rain\", \"cold\"}, \"carry umbrella\"),\n",
    "    ({\"cold\"}, \"wear jacket\"),\n",
    "    ({\"rain\"}, \"use raincoat\")\n",
    "]\n",
    "\n",
    "for conditions, result in rules:\n",
    "    if conditions.issubset(facts):\n",
    "        print(result)\n"
   ]
  }
