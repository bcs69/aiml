   "source": [
    "def hanoi(n, source, target, auxiliary):\n",
    "    if n == 0:\n",
    "        return\n",
    "    hanoi(n - 1, source, auxiliary, target)\n",
    "    print(\"Move disk\", n, \"from\", source, \"to\", target)\n",
    "    hanoi(n - 1, auxiliary, target, source)\n",
    "\n",
    "hanoi(3, \"A\", \"C\", \"B\")\n"
   ]
  }
