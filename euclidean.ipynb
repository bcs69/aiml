   "source": [
    "import math\n",
    "\n",
    "point1 = [2, 3, 4]\n",
    "point2 = [5, 7, 6]\n",
    "\n",
    "distance = math.sqrt(sum((a - b) ** 2 for a, b in zip(point1, point2)))\n",
    "print(\"Data Point:\", point1)\n",
    "print(\"Data Point:\", point2)\n",
    "print(\"Euclidean Distance =\", round(distance, 3))\n"
   ]
  }
