    "from sklearn.svm import SVC\n",
    "\n",
    "X = [[1, 2], [2, 3], [5, 5]]\n",
    "y = [0, 0, 1]\n",
    "\n",
    "model = SVC(kernel=\"rbf\", gamma=\"scale\")\n",
    "model.fit(X, y)\n",
    "print(\"Prediction for [4, 4]:\", model.predict([[4, 4]])[0])\n"
   ]
  }
